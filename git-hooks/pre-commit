#!/usr/bin/env bash
set -euo pipefail

echo "==> pre-commit: checking formatting..."

# Go formatting
UNFORMATTED=$(gofmt -l . 2>/dev/null || true)
if [ -n "${UNFORMATTED}" ]; then
    echo "ERROR: the following Go files are not formatted:"
    echo "${UNFORMATTED}"
    echo ""
    echo "Run 'gofmt -w .' to fix."
    exit 1
fi

# Go vet
echo "==> pre-commit: running go vet..."
go vet ./... 2>&1 || {
    echo "ERROR: go vet failed"
    exit 1
}

# Check for secrets
echo "==> pre-commit: scanning for secrets..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
for file in ${STAGED_FILES}; do
    if grep -qEi '(password|secret|api_key|apikey|token|private_key)\s*[:=]\s*["\x27][^"\x27]{8,}' "${file}" 2>/dev/null; then
        echo "ERROR: potential secret detected in ${file}"
        echo "If this is a false positive, review and use 'git commit --no-verify' (requires justification)."
        exit 1
    fi
done

echo "==> pre-commit: all checks passed"
